# URL du moteur de décision (/v1/systemone). Vide = arbitrage de repli déterministe uniquement.
KEV_URL=http://laya:8008
# Laya : checkpoint multilingue (français) ; vide = checkpoint anglais
LAYA_SUBFOLDER=multilingual
# Index PyTorch pour le build de Laya (cpu, ou https://download.pytorch.org/whl/cu128 pour NVIDIA)
LAYA_TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Variante Kev (docker-compose.kev.yml) : kev-4b = GPU ~10 Go recommandé ; kev-0.6b = léger
KEV_RUN=jaredpalmer/kev-4b
KEV_TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Jeton optionnel exigé par le moteur (Authorization: Bearer)
KEV_API_KEY=
KEV_TIMEOUT_MS=1500
KEV_CLUE_TIMEOUT_MS=1000
# p(indice interdit) au-delà de laquelle le moteur rejette un indice. 0 = consultatif (recommandé).
KEV_CLUE_THRESHOLD=0
MIN_PLAYERS=4
ROUND_SECONDS=180
# Serveur TURN optionnel (joueurs derrière des NAT stricts / réseaux mobiles)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
