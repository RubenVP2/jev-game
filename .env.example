# Modèle Ollama utilisé par Kev (llama3.1:8b ou mistral:7b recommandés avec GPU)
KEV_MODEL=qwen2.5:1.5b
# Laisser vide pour désactiver le LLM (arbitrage de repli déterministe uniquement)
OLLAMA_URL=http://ollama:11434
KEV_TIMEOUT_MS=2500
KEV_CLUE_TIMEOUT_MS=1500
MIN_PLAYERS=4
ROUND_SECONDS=180
# Serveur TURN optionnel (joueurs derrière des NAT stricts / réseaux mobiles)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
