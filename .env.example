# URL du serveur Kev (/v1/systemone). Vide = arbitrage de repli déterministe uniquement.
KEV_URL=http://kev:8008
# Checkpoint Hugging Face servi : jaredpalmer/kev-0.6b (CPU), kev-4b / kev-8b (GPU recommandé)
KEV_RUN=jaredpalmer/kev-0.6b
# Index PyTorch pour le build de Kev (cpu, ou https://download.pytorch.org/whl/cu128 pour NVIDIA)
KEV_TORCH_INDEX=https://download.pytorch.org/whl/cpu
# Jeton optionnel exigé par Kev (Authorization: Bearer)
KEV_API_KEY=
KEV_TIMEOUT_MS=3000
KEV_CLUE_TIMEOUT_MS=2000
# Probabilité « indice légal » (noul) minimale pour accepter un indice. 0 = Kev consultatif.
KEV_CLUE_THRESHOLD=0
MIN_PLAYERS=4
ROUND_SECONDS=180
# Serveur TURN optionnel (joueurs derrière des NAT stricts / réseaux mobiles)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
