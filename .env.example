# ============================================================================
# REQUIRED: three keys
# ============================================================================

# 1. LLM: at least one key (several = automatic fallback between providers)
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=

# 2. Discord bot token (README > Discord). `veille doctor` prints the invite link.
DISCORD_BOT_TOKEN=

# 3. Upload-Post API key (app.upload-post.com): connect Threads and TikTok once in its dashboard.
#    No domain, no Meta/TikTok developer app, no DNS verification needed.
UPLOADPOST_API_KEY=

# ============================================================================
# OPTIONAL
# ============================================================================

# Discord: defaults to #veille-drafts (created if missing) and the server owner as reviewer.
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# Upload-Post profile to post with (defaults to the first profile of the account).
UPLOADPOST_USER=

# Reddit "script" app (https://www.reddit.com/prefs/apps). Without it, Reddit often blocks servers.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=veille/0.1 by u/yourname

# Raises the GitHub API rate limit used to read READMEs.
GITHUB_TOKEN=

# ============================================================================
# ALTERNATIVE: "direct" publishing with your own Meta and TikTok apps (no Upload-Post)
# Needs a domain pointing to the server: docker compose --profile direct up -d
# ============================================================================

DOMAIN=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Overrides (derived from DOMAIN when empty)
PUBLIC_BASE_URL=
TIKTOK_REDIRECT_URI=
THREADS_REDIRECT_URI=
# Alternative to /connect: a long-lived Threads token generated in the Meta dashboard.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
