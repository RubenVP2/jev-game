# --- LLM providers (at least one) ---
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=

# --- Sources ---
# Optional, raises the GitHub API rate limit used to fetch READMEs.
GITHUB_TOKEN=
# Reddit "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=veille/0.1 by u/yourname

# --- Discord validation bot ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to press the buttons.
DISCORD_ALLOWED_USER_IDS=

# --- Public media (slides must be reachable by Threads and TikTok) ---
# HTTPS URL that serves the media server (Caddy in docker-compose). For TikTok
# this domain must be verified in the TikTok developer portal.
PUBLIC_BASE_URL=https://veille.example.com
DOMAIN=veille.example.com

# --- Threads (Meta) ---
# Long-lived token (60 days, refreshed automatically by the app).
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://veille.example.com/tiktok/callback

# --- Paths ---
VEILLE_CONFIG=config.yaml
VEILLE_DATA_DIR=data
