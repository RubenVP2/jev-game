# ============================================================================
# REQUIRED
# ============================================================================

# --- LLM: at least one key (all three = automatic fallback between providers)
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=

# --- Discord validation bot (see README > Discord)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Your Discord user ID (comma-separated for several reviewers)
DISCORD_ALLOWED_USER_IDS=

# --- Domain pointing to the server. Slides are served from https://DOMAIN/media/
# (HTTPS certificate obtained automatically by Caddy).
DOMAIN=veille.example.com

# ============================================================================
# PUBLICATION (a platform without credentials is skipped, not an error)
# ============================================================================

# --- Threads app (developers.facebook.com). Then type /connect Threads on Discord and click.
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- TikTok app (developers.tiktok.com). Then type /connect TikTok on Discord and click.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ============================================================================
# OPTIONAL
# ============================================================================

# Reddit "script" app (https://www.reddit.com/prefs/apps). Without it, Reddit often blocks servers.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=veille/0.1 by u/yourname

# Raises the GitHub API rate limit used to read READMEs.
GITHUB_TOKEN=

# Overrides (derived from DOMAIN when empty)
PUBLIC_BASE_URL=
TIKTOK_REDIRECT_URI=
THREADS_REDIRECT_URI=
# Alternative to /connect: a long-lived Threads token generated in the Meta dashboard.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
